#!/bin/sh
set -eu
cd /app
case "${HRMS_RUN_MODE:-production}" in
  production|development) ;;
  *) printf '%s\n' 'Choose production or development for HRMS_RUN_MODE.'; exit 1 ;;
esac
python docker/patch-framework.py
python docker/setup.py
node /app/vendor/framework/socketio.js > /app/.runtime/bench/logs/socket.log 2>&1 &
socket_pid=$!
cd /app/.runtime/bench/sites
python -m frappe.utils.bench_helper frappe worker > ../logs/worker.log 2>&1 &
worker_pid=$!
scheduler_pid=""
if [ "$(cat ../.outside-configured)" = yes ]; then
  python -m frappe.utils.bench_helper frappe schedule > ../logs/scheduler.log 2>&1 &
  scheduler_pid=$!
fi
server_pid=""
cleanup() { kill "$socket_pid" "$worker_pid" ${scheduler_pid:+"$scheduler_pid"} ${server_pid:+"$server_pid"} 2>/dev/null || true; }
trap cleanup EXIT INT TERM
if [ "${HRMS_RUN_MODE:-production}" = production ]; then
  gunicorn --bind 0.0.0.0:8000 --workers 2 --threads 2 --worker-class gthread \
    --timeout 120 --keep-alive 5 --access-logfile - --error-logfile - hrms.wsgi:application &
else
  python -m frappe.utils.bench_helper frappe --site "$HRMS_SITE_NAME" serve --port 8000 --noreload &
fi
server_pid=$!
wait "$server_pid"
